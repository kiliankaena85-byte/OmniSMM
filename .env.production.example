# ==============================================================================
# OmniSMM 1.0 — Production Environment Template (.env.production)
# ==============================================================================

# ── Database (PostgreSQL 15+ Least-Privilege & Audit Hardening) ──
POSTGRES_DB=smmplan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_ADMIN_PASSWORD
# Least-privilege application role (HIGH-01 / Least Privilege)
POSTGRES_APP_USER=smmplan_app
POSTGRES_APP_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD
DATABASE_URL=postgresql://smmplan_app:CHANGE_ME_STRONG_APP_PASSWORD@db:5432/smmplan?schema=public&connection_limit=20&pool_timeout=30

# ── Redis (Protected with strong password, SEC-001) ──
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379

# ── Core Runtime & Multi-Tenant Domains ──
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=https://smmplan.pro
NEXT_PUBLIC_FLUX_URL=https://smmflux.ru

# ── Security & Cryptographic Secrets (Must be 32+ bytes random / 64 hex) ──
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_HEX_CHARS
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_HEX_CHARS
APP_ENCRYPTION_KEY=CHANGE_ME_EXACTLY_64_HEX_CHARACTERS_FOR_AES_256
DATA_SALT=CHANGE_ME_RANDOM_SALT_FOR_SEARCH_HASH
WEBHOOK_SECRET=CHANGE_ME_RANDOM_WEBHOOK_HMAC_SECRET

# ── Direct Production SMTP (Port 465 SSL, Direct without Proxy, SEC-003) ──
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@smmplan.pro
SMTP_PASSWORD=CHANGE_ME_MAIL_APP_PASSWORD
SMTP_FROM="SMMplan <noreply@smmplan.pro>"
SMTP_REPLY_TO=support@smmplan.pro
SMTP_DIRECT_SSL=true

# ── Telegram Bots & Emergency Alerts ──
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_CUSTOMER_BOT_TOKEN
TELEGRAM_BOT_USERNAME=smmplan_bot
ADMIN_ALERT_BOT_TOKEN=CHANGE_ME_INCIDENT_ALERT_BOT_TOKEN
ADMIN_ALERT_CHAT_ID=CHANGE_ME_TELEGRAM_ADMIN_CHAT_ID

# ── Payment Gateways (Live API Keys) ──
# ЮKassa (54-ФЗ Fiscal Receipts, VAT 2026)
YOOKASSA_SHOP_ID=CHANGE_ME_YOOKASSA_SHOP_ID
YOOKASSA_SECRET_KEY=CHANGE_ME_YOOKASSA_SECRET_KEY

# Robokassa
ROBOKASSA_LOGIN=CHANGE_ME_ROBOKASSA_MERCHANT_LOGIN
ROBOKASSA_PASS1=CHANGE_ME_ROBOKASSA_PASSWORD_1
ROBOKASSA_PASS2=CHANGE_ME_ROBOKASSA_PASSWORD_2
ROBOKASSA_TEST_MODE=false

# CryptoBot (@CryptoBot Pay API)
CRYPTOBOT_API_KEY=CHANGE_ME_CRYPTOBOT_API_KEY
CRYPTOBOT_WEBHOOK_SECRET=CHANGE_ME_CRYPTOBOT_WEBHOOK_SECRET

# ── Production Hardening & Circuit Breakers ──
ENABLE_DEV_ROUTES=false
ENABLE_DEV_BYPASS=false
DDOS_SHIELD_ENABLED=true
ADMIN_SESSION_TTL_SECONDS=28800
